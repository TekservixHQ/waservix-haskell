cabal-version:      2.4
name:               waservix
version:            1.0.0
synopsis:           WAservix WhatsApp API Gateway client: send WhatsApp messages from your own number
description:        WAservix WhatsApp API Gateway: official Haskell client by Tekservix. Send WhatsApp texts, images, documents and locations from your own number, check message status, check numbers, read contacts and groups, and verify webhook calls. Requires a Tekservix account with WAservix: <https://tekservix.com/waservix>.
homepage:           https://tekservix.com/waservix
bug-reports:        https://github.com/TekservixHQ/waservix-haskell/issues
license:            MIT
license-file:       LICENSE
author:             Tekservix
maintainer:         support@tekservix.com
copyright:          (c) 2026 Tekservix
category:           Network, Web, API
build-type:         Simple
extra-doc-files:    README.md
                    CHANGELOG.md
tested-with:        GHC == 9.4.8, GHC == 9.6.6, GHC == 9.8.4, GHC == 9.10.1

source-repository head
  type:     git
  location: https://github.com/TekservixHQ/waservix-haskell.git

library
  exposed-modules:  Network.WAservix
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >= 4.14 && < 5
                    , aeson >= 2.0 && < 2.3
                    , bytestring >= 0.10 && < 0.13
                    , text >= 1.2 && < 2.2
                    , http-client >= 0.7 && < 0.8
                    , http-client-tls >= 0.3.6 && < 0.4
                    , http-types >= 0.12 && < 0.13


test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base, waservix, text, bytestring
